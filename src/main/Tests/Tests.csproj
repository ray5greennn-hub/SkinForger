<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline checks for the authored Main's pure layer: no Unity, no MelonLoader, no game.
    Run it from this folder with "dotnet run -c Release"; pass a real SkinCreator\Images folder to also
    round-trip the files in it.
    With a folder given it also round-trips every real manifest.json and anchor sidecar found there.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Tests</AssemblyName>
    <RootNamespace>SkinForger.Main.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <RestoreConfigFile>$(MSBuildProjectDirectory)\..\..\NuGet.Config</RestoreConfigFile>
    <OutputPath>Build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Pure\**\*.cs" />
    <!-- The one definition of where the loading pictures live, so the test cannot drift from the
         feature. Only this file: the manager itself needs Harmony and the game. -->
    <Compile Include="..\..\CustomLoadingPic\Runtime\LoadingPaths.cs" />
  </ItemGroup>
</Project>
