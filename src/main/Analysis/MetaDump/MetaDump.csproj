<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>MetaDump</AssemblyName>
    <RootNamespace>SkinForger.Analysis</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Cecil reads metadata only: no Il2Cpp dependency has to resolve, which is why reflection
         (Assembly.LoadFrom) cannot be used here. -->
    <Reference Include="Mono.Cecil">
      <HintPath>..\..\..\..\MelonLoader\net6\Mono.Cecil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
