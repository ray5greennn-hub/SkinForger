<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SkinForger.TouhouCompat</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net6.0</TargetFramework>
    <UseAppHost>False</UseAppHost>
    <GameRoot>$(MSBuildThisFileDirectory)..\..\</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(GameRoot)MelonLoader\net6\MelonLoader.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameRoot)MelonLoader\net6\0Harmony.dll</HintPath></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GameRoot)MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameRoot)MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Il2Cppspine-unity"><HintPath>$(GameRoot)MelonLoader\Il2CppAssemblies\Il2Cppspine-unity.dll</HintPath></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(GameRoot)MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameRoot)MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>
</Project>
